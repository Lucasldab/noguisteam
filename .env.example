STEAM_API_KEY=your_steam_api_key
STEAM_ID=your_17_digit_steam_id
STEAM_USERNAME=your_steam_username

# Optional: leave empty / unset to use steamcmd's cached session.
# Run `steamcmd +login <user>` once interactively to cache credentials, then
# delete this line so the password lives only in steamcmd's saved-session store.
STEAM_PASSWORD=""

ITAD_KEY=your_itad_api_key
COUNTRY=BR
STEAMCMD=/usr/bin/steamcmd

# Set to 1/true to sync the library automatically on startup.
AUTO_SYNC=0
