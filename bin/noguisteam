#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BINARY="$PROJECT_ROOT/target/release/noguisteam"

if [[ ! -f "$BINARY" ]]; then
    echo "Binary not found. Building..."
    cd "$PROJECT_ROOT" && cargo build --release
fi

export NOGUISTEAM_HOME="$PROJECT_ROOT"
exec "$BINARY"
